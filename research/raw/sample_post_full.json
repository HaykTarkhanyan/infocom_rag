  "title": {
    "rendered": "ԱԺ «Ուժեղ Հայաստան» խմբակցության ղեկավար է ընտրվել Նարեկ Կարապետյանը"
  },
  "content": {
    "rendered": "<p>&#x531;&#x566;&#x563;&#x561;&#x575;&#x56B;&#x576; &#x56A;&#x578;&#x572;&#x578;&#x57E;&#x56B; &#xAB;&#x548;&#x582;&#x56A;&#x565;&#x572; &#x540;&#x561;&#x575;&#x561;&#x57D;&#x57F;&#x561;&#x576;&#xBB; &#x56D;&#x574;&#x562;&#x561;&#x56F;&#x581;&#x578;&#x582;&#x569;&#x575;&#x561;&#x576; &#x572;&#x565;&#x56F;&#x561;&#x57E;&#x561;&#x580; &#x567; &#x568;&#x576;&#x57F;&#x580;&#x57E;&#x565;&#x56C; &#x546;&#x561;&#x580;&#x565;&#x56F; &#x53F;&#x561;&#x580;&#x561;&#x57A;&#x565;&#x57F;&#x575;&#x561;&#x576;&#x568;, &#x56D;&#x574;&#x562;&#x561;&#x56F;&#x581;&#x578;&#x582;&#x569;&#x575;&#x561;&#x576; &#x584;&#x561;&#x580;&#x57F;&#x578;&#x582;&#x572;&#x561;&#x580;&#x55D; &#x54F;&#x56B;&#x563;&#x580;&#x561;&#x576; &#x531;&#x562;&#x580;&#x561;&#x570;&#x561;&#x574;&#x575;&#x561;&#x576;&#x568;: &#x531;&#x575;&#x57D; &#x574;&#x561;&#x57D;&#x56B;&#x576; &#x570;&#x561;&#x572;&#x578;&#x580;&#x564;&#x578;&#x582;&#x574; &#x567; &#x568;&#x576;&#x564;&#x564;&#x56B;&#x574;&#x561;&#x564;&#x56B;&#x580; &#x564;&#x561;&#x577;&#x56B;&#x576;&#x584;&#x568; &#x56B;&#x580; &#x586;&#x565;&#x575;&#x57D;&#x562;&#x578;&#x582;&#x584;&#x575;&#x561;&#x576; &#x567;&#x57B;&#x578;&#x582;&#x574;:</p>\n<p>&#x531;&#x575;&#x564; &#x568;&#x576;&#x57F;&#x580;&#x578;&#x582;&#x569;&#x575;&#x578;&#x582;&#x576;&#x576;&#x565;&#x580;&#x578;&#x57E; &#x571;&#x587;&#x561;&#x57E;&#x578;&#x580;&#x57E;&#x561;&#x56E; 9-&#x580;&#x564; &#x563;&#x578;&#x582;&#x574;&#x561;&#x580;&#x574;&#x561;&#x576; &#x531;&#x566;&#x563;&#x561;&#x575;&#x56B;&#x576; &#x56A;&#x578;&#x572;&#x578;&#x57E;&#x576; &#x561;&#x577;&#x56D;&#x561;&#x57F;&#x561;&#x576;&#x584;&#x576;&#x565;&#x580;&#x568; &#x57D;&#x56F;&#x57D;&#x578;&#x582;&#x574; &#x567; &#x57E;&#x561;&#x572;&#x568;:</p>\n<p>&#xAB;&#x548;&#x582;&#x56A;&#x565;&#x572; &#x540;&#x561;&#x575;&#x561;&#x57D;&#x57F;&#x561;&#x576;&#xBB; &#x564;&#x561;&#x577;&#x56B;&#x576;&#x584;&#x568; &#x568;&#x576;&#x57F;&#x580;&#x578;&#x582;&#x569;&#x575;&#x578;&#x582;&#x576;&#x576;&#x565;&#x580;&#x56B; &#x561;&#x580;&#x564;&#x575;&#x578;&#x582;&#x576;&#x584;&#x578;&#x582;&#x574; &#x57D;&#x57F;&#x561;&#x581;&#x565;&#x56C; &#x567; 29 &#x574;&#x561;&#x576;&#x564;&#x561;&#x57F;&#x589;</p>\n<p>&#x531;&#x57E;&#x565;&#x56C;&#x56B; &#x57E;&#x561;&#x572;&#x55D; &#x564;&#x561;&#x577;&#x56B;&#x576;&#x584;&#x568; &#x570;&#x580;&#x561;&#x57A;&#x561;&#x580;&#x561;&#x56F;&#x565;&#x56C; &#x567;&#x580; &#x57A;&#x561;&#x57F;&#x563;&#x561;&#x574;&#x561;&#x57E;&#x578;&#x580;&#x576;&#x565;&#x580;&#x56B; &#x581;&#x578;&#x582;&#x581;&#x561;&#x56F;&#x568;, &#x578;&#x580;&#x578;&#x582;&#x574; &#x570;&#x561;&#x575;&#x57F;&#x576;&#x57E;&#x565;&#x56C; &#x567;&#x56B;&#x576;&#x55D; &#x546;&#x561;&#x580;&#x565;&#x56F; &#x53F;&#x561;&#x580;&#x561;&#x57A;&#x565;&#x57F;&#x575;&#x561;&#x576;&#x568;, &#x531;&#x580;&#x561;&#x574; &#x54E;&#x561;&#x580;&#x564;&#x587;&#x561;&#x576;&#x575;&#x561;&#x576;&#x568;,&#x534;&#x561;&#x57E;&#x56B;&#x569; &#x542;&#x561;&#x566;&#x56B;&#x576;&#x575;&#x561;&#x576;&#x568;, &#x54C;&#x578;&#x582;&#x562;&#x565;&#x576; &#x544;&#x56D;&#x56B;&#x569;&#x561;&#x580;&#x575;&#x561;&#x576;&#x568;, &#x531;&#x580;&#x565;&#x563;&#x561; &#x540;&#x578;&#x57E;&#x57D;&#x565;&#x583;&#x575;&#x561;&#x576;&#x568;, &#x544;&#x561;&#x574;&#x56B;&#x56F;&#x578;&#x576; &#x531;&#x57D;&#x56C;&#x561;&#x576;&#x575;&#x561;&#x576;&#x568;, &#x544;&#x561;&#x580;&#x56B;&#x561;&#x576;&#x576;&#x561; &#x542;&#x561;&#x570;&#x580;&#x561;&#x574;&#x561;&#x576;&#x575;&#x561;&#x576;&#x568;, &#x540;&#x561;&#x575;&#x56F; &#x54D;&#x578;&#x582;&#x584;&#x56B;&#x561;&#x57D;&#x575;&#x561;&#x576;&#x568;, &#x531;&#x580;&#x563;&#x56B;&#x577;&#x57F;&#x56B; &#x534;&#x561;&#x580;&#x562;&#x56B;&#x576;&#x575;&#x561;&#x576;&#x568;, &#x53B;&#x580;&#x56B;&#x576;&#x561; &#x545;&#x578;&#x56C;&#x575;&#x561;&#x576;&#x568;, &#x537;&#x564;&#x563;&#x561;&#x580; &#x542;&#x561;&#x566;&#x561;&#x580;&#x575;&#x561;&#x576;&#x568;, &#x54F;&#x56B;&#x563;&#x580;&#x561;&#x576; &#x531;&#x562;&#x580;&#x561;&#x570;&#x561;&#x574;&#x575;&#x561;&#x576;&#x568;, &#x53C;&#x565;&#x576;&#x561; &#x544;&#x561;&#x569;&#x587;&#x578;&#x57D;&#x575;&#x561;&#x576;&#x568;, &#x531;&#x576;&#x564;&#x580;&#x561;&#x576;&#x56B;&#x56F; &#x533;&#x587;&#x578;&#x580;&#x563;&#x575;&#x561;&#x576;&#x568;, &#x540;&#x561;&#x575;&#x56F; &#x556;&#x561;&#x580;&#x574;&#x561;&#x576;&#x575;&#x561;&#x576;&#x568;, &#x533;&#x580;&#x56B;&#x577;&#x561; &#x539;&#x561;&#x574;&#x580;&#x561;&#x566;&#x575;&#x561;&#x576;&#x568;, &#x53C;&#x56B;&#x561;&#x576;&#x561; &#x533;&#x561;&#x57D;&#x57A;&#x561;&#x580;&#x575;&#x561;&#x576;&#x568;, &#x54E;&#x561;&#x572;&#x56B;&#x576;&#x561;&#x56F; &#x54E;&#x561;&#x580;&#x564;&#x561;&#x576;&#x578;&#x57E;&#x568;, &#x533;&#x561;&#x57C;&#x576;&#x56B;&#x56F; &#x534;&#x561;&#x57E;&#x569;&#x575;&#x561;&#x576;&#x568;, &#x53C;&#x56B;&#x561;&#x576;&#x561; &#x544;&#x561;&#x576;&#x578;&#x582;&#x56F;&#x575;&#x561;&#x576;&#x568;, &#x540;&#x561;&#x580;&#x578;&#x582;&#x569;&#x575;&#x578;&#x582;&#x576; &#x544;&#x576;&#x561;&#x581;&#x561;&#x56F;&#x561;&#x576;&#x575;&#x561;&#x576;&#x568;, &#x54E;&#x580;&#x578;&#x582;&#x575;&#x580; &#x531;&#x575;&#x57E;&#x561;&#x566;&#x575;&#x561;&#x576;&#x568;, &#x54D;&#x575;&#x578;&#x582;&#x566;&#x561;&#x576;&#x576;&#x561; &#x531;&#x57E;&#x565;&#x57F;&#x56B;&#x57D;&#x575;&#x561;&#x576;&#x568;, &#x540;&#x561;&#x580;&#x578;&#x582;&#x569;&#x575;&#x578;&#x582;&#x576; &#x540;&#x561;&#x580;&#x578;&#x582;&#x569;&#x575;&#x578;&#x582;&#x576;&#x575;&#x561;&#x576;&#x568;, &#x547;&#x56B;&#x580;&#x561;&#x566; &#x544;&#x561;&#x576;&#x578;&#x582;&#x56F;&#x575;&#x561;&#x576;&#x568; &#x531;&#x576;&#x578;&#x582;&#x577; &#x544;&#x56B;&#x580;&#x566;&#x578;&#x575;&#x561;&#x576;&#x568;, &#x531;&#x576;&#x578;&#x582;&#x577;&#x561;&#x57E;&#x561;&#x576; &#x544;&#x561;&#x576;&#x578;&#x582;&#x579;&#x561;&#x580;&#x575;&#x561;&#x576;&#x568;, &#x540;&#x561;&#x57D;&#x574;&#x56B;&#x56F; &#x535;&#x576;&#x563;&#x578;&#x580;&#x575;&#x561;&#x576;&#x568; &#x587; &#x531;&#x580;&#x574;&#x561;&#x576; &#x531;&#x57E;&#x579;&#x575;&#x561;&#x576;&#x568;&#x589;</p>\n",
