# SITE_ADDRESS comes from docker-compose, which derives it from DOMAIN:
#
#   DOMAIN set    ->  SITE_ADDRESS=rag.example.com  ->  automatic Let's Encrypt HTTPS
#   DOMAIN unset  ->  SITE_ADDRESS=:80              ->  plain HTTP on the server's IP
#
# The HTTP mode exists because Let's Encrypt will not issue a certificate for a
# bare IP address, only for a domain name. It is a DEMO-ONLY fallback: over plain
# HTTP the APP_PASSWORD and every question and answer cross the network in
# cleartext. See DEFERRED_TODO.md -- setting DOMAIN is the whole fix.

{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Chainlit is a websocket app; Caddy proxies the upgrade transparently, but
	# the read timeout must outlast a slow answer (retrieval + generation can be
	# ~7s, and the model load on first boot is longer still).
	reverse_proxy app:8001 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	log {
		output stdout
		format console
	}
}
