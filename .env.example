# Copy to .env and fill in. .env is gitignored; this file is not.

# Hugging Face access token (https://huggingface.co/settings/tokens)
# Only needed for gated or private repos -- the ATE-2 models are public (MIT).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NOTE: the embedding model is set in config.toml ([embedding] model),
# not here. Two sources of truth for it meant chunking could use one
# tokenizer while retrieval used another -- a silent retrieval bug.

# Where downloaded model weights live. LOCAL DEVELOPMENT ONLY -- this is a
# Windows path. Do NOT copy it to a server: the Docker image sets HF_HOME=/models
# and points it at a volume, and a stray Windows path here would override that
# and send the 2 GB download somewhere useless inside the container.
HF_HOME=C:/hf_models

# OpenRouter (https://openrouter.ai/keys) — used for Gemini calls
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Neon Postgres — session/turn persistence and cost telemetry
NEON_DB_STRING=postgresql://user:password@host.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Deployment only (Hetzner + Caddy); not needed for local development ---
# Caddy issues a Let's Encrypt certificate for this domain. Point an A record at
# the server BEFORE first start, or repeated validation failures hit rate limits.
DOMAIN=rag.example.com
ACME_EMAIL=you@example.com

# Gates the UI. Without it the deployment is open to anyone and they spend the
# OpenRouter key -- there is no per-user cap or rate limit.
APP_PASSWORD=change-me
# Signs Chainlit session cookies. REQUIRED whenever APP_PASSWORD is set --
# Chainlit refuses to start with auth enabled and no secret. Generate one with:
#   chainlit create-secret
CHAINLIT_AUTH_SECRET=change-me-to-something-long-and-random
