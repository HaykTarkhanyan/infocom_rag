# Copy to .env and fill in. .env is gitignored; this file is not.

# Hugging Face access token (https://huggingface.co/settings/tokens)
# Only needed for gated or private repos -- the ATE-2 models are public (MIT).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Embedding model. ATE-2 = Armenian Text Embeddings 2 (Metric-AI).
#   -base  278M params, 768-dim, faster on CPU
#   -large 560M params, 1024-dim, better quality, ~2x slower
EMBEDDING_MODEL=Metric-AI/armenian-text-embeddings-2-base

# Where downloaded model weights live.
HF_HOME=C:/hf_models
